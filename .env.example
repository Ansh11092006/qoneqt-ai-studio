# Gemini API Configuration (Prompt Enhancement & Storyboard Director)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Pixabay Video & Photo API (Scene Visual Source)
PIXABAY_API_KEY=

# Watermark Configuration (Burned in via FFmpeg)
WATERMARK_ENABLED=true
WATERMARK_TEXT=Qoneqt.ai
WATERMARK_POSITION=bottom-right
WATERMARK_OPACITY=0.6
WATERMARK_SIZE=medium

# Demo & Server Configuration
DEMO_MODE=false
PORT=8000
HOST=0.0.0.0
VITE_REPO_URL=https://github.com/qoneqt/qoneqt-ai-studio
